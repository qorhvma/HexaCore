        def MjcActuator "L1_tibia_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -1.7453292608261108, -0.01745329238474369, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 1.8632999658584595
            uniform double mjc:forceRange:min = -1.8632999658584595
            uniform double[] mjc:gainPrm = [1.7453292608261108, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </HexapodRobot/Physics/L1_tibia>
        }


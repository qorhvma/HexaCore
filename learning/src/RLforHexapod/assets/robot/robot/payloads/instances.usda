{
    def Xform "hw674" (
        prepend references = @./geometries.usd@</Geometries/hw674>
    )
    {
        over "hw674" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/hw674/VisualMaterials/hw674_material>
        }

        def Scope "VisualMaterials"
        {
            def Material "hw674_material" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/hw674_material>
            )
            {
            }
        }
    }


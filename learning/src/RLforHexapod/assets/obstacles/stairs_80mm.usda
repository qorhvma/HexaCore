#usda 1.0
(
    defaultPrim = "Stairs"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Stairs"
{
    def Material "PhysMat" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1
        float physics:restitution = 0
        float physics:staticFriction = 1
    }

    def Cube "step_0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Stairs/PhysMat> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double size = 1
        float3 xformOp:scale = (0.3, 1, 0.08)
        double3 xformOp:translate = (0.15, 0, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "step_1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Stairs/PhysMat> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double size = 1
        float3 xformOp:scale = (0.3, 1, 0.16)
        double3 xformOp:translate = (0.44999999999999996, 0, 0.08)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "step_2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Stairs/PhysMat> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double size = 1
        float3 xformOp:scale = (0.8, 1, 0.24)
        double3 xformOp:translate = (1, 0, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

